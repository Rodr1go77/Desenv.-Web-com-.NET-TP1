@page "CadastrarEvento"
@model EXE12.Pages.AddEventModel
@{
	ViewData["Title"] = "Cadastrar Evento";
}

<h2>Cadastrar Novo Evento</h2>

<form method="post" class="mt-3">
	<div class="mb-3">
		<label asp-for="NovoEvento.Titulo" class="form-label">Título do Evento</label>
		<input asp-for="NovoEvento.Titulo" class="form-control" />
		<span asp-validation-for="NovoEvento.Titulo" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="NovoEvento.Data" class="form-label">Data</label>
		<input asp-for="NovoEvento.Data" type="date" class="form-control" />
		<span asp-validation-for="NovoEvento.Data" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="NovoEvento.Local" class="form-label">Local</label>
		<input asp-for="NovoEvento.Local" class="form-control" />
		<span asp-validation-for="NovoEvento.Local" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">Salvar Evento</button>
</form>

@if (Model.EventoCriado)
{
	<div class="alert alert-success mt-4">
		<h4>Evento criado com sucesso!</h4>
		<p><strong>Título:</strong> @Model.NovoEvento.Titulo</p>
		<p><strong>Data:</strong> @Model.NovoEvento.Data?.ToString("dd/MM/yyyy")</p>
		<p><strong>Local:</strong> @Model.NovoEvento.Local</p>
	</div>
}