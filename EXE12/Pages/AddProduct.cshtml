@page "/AddProduct"
@model EXE12.Pages.AddProductModel
@{

	ViewData["Title"] = "Adicionar Produto";

}

<form method="post">
	<div class="form-group">
		<label asp-for="Produto.Nome" class="control-label"></label>
		<input asp-for="Produto.Nome" class="form-control" />
		<span asp-validation-for="Produto.Nome" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Produto.Preco" class="control-label"></label>
		<input asp-for="Produto.Preco" class="form-control" />
		<span asp-validation-for="Produto.Preco" class="text-danger"></span>
	</div>
	<br />
	<div class="form-group">
		<input type="submit" value="Adicionar Produto" class="btn btn-primary" />
	</div>
</form>

@if (Model.DadosEnviados)
{
	<div class="alert alert-success mt-4">
		<h4>Produto cadastrado com sucesso:</h4>
		<p><strong>Nome:</strong> @Model.Produto.Nome</p>
		<p><strong>Preço:</strong> @Model.Produto.Preco.ToString("C")</p>
	</div>
}